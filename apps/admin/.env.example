# Copy to .env.local. Nothing is required: the console uses the Stellance API by default.

# Data source: "live" (default, the Stellance API; sign in with an account that has admin rights) or
# "mock" (demo data in the browser; demo admin: admin@usestellance.com / Password1).
# NEXT_PUBLIC_API_SOURCE=mock

# Stellance API (live mode). The browser calls this app's /api/v1 proxy, which forwards here.
# API_PROXY_TARGET=https://api.usestellance.com/api/v1

# Canonical URL (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
