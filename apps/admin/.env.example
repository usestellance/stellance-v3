# Copy to .env.local. Nothing is required: the console runs on demo data by default.

# Data source: "mock" (default, demo data in the browser) or "live" (the Stellance API).
# Demo admin: admin@usestellance.com / Password1
# NEXT_PUBLIC_API_SOURCE=live

# Stellance API (live mode). The browser calls this app's /api/v1 proxy, which forwards here.
# API_PROXY_TARGET=https://api.usestellance.com/api/v1

# Canonical URL (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3001
