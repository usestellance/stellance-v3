# Copy to .env.local. On Vercel, set only what you want to override.

# Data source: "mock" (default for now: demo data in the browser, every screen and payment state
# explorable, sign in with demo@usestellance.com / Password1) or "live" (the Stellance API).
# NEXT_PUBLIC_API_SOURCE=live

# Payment detection: "api" (the backend's detection endpoints, docs/PLAN.md; the default with demo data)
# or "horizon" (the app reads Stellar Testnet itself; the default against the live API until the
# backend ships detection).
# NEXT_PUBLIC_PAYMENTS_SOURCE=horizon
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Stellance API (live mode). The browser calls this app's /api/v1 proxy (next.config.ts), which forwards here.
# Defaults to https://api.usestellance.com/api/v1.
# API_PROXY_TARGET=http://localhost:8080/api/v1
# Or force direct calls (the API must allow this origin in CORS). NEXT_PUBLIC_BASE_URL is the old name.
# NEXT_PUBLIC_API_URL=https://api.usestellance.com/api/v1

# Google sign-in: the public OAuth client id. Never put the client secret here.
# (With demo data, "Continue with Google" signs straight into the demo account.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Canonical URLs (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002
