# Promo / walkthrough videos (/brag): keep the setups (plans, compositions, scripts), not the media.
# Renders, screen recordings, voice-over and music are heavy and can be regenerated.
brag-output*/**/*.mp4
brag-output*/**/*.mov
brag-output*/**/*.webm
brag-output*/**/*.wav
brag-output*/**/*.mp3
brag-output*/**/*.ogg
brag-output*/**/*.y4m