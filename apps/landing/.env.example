# Copy to .env.local. Nothing here is required: every URL has a default per environment
# (src/lib/site.ts): production → usestellance.com / app.usestellance.com, previews → the deployment
# host and /app, dev → localhost.

# This site's canonical URL (metadata, robots).
# NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Where "Sign In" / "Sign Up" and the old app paths (/auth, /client, …) go (apps/web).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
